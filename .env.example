PORT=3318
HOST=127.0.0.1
TRENDSETTER_DATA_DIR=./data
BODY_LIMIT_BYTES=26214400

# Beginner AI setup.
# Supported values: none, openai, openrouter, nvidia-nim, ollama, llama-cpp
# none = local hash embeddings and extractive answers, no API key needed.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# NVIDIA NIM example. Put the real key only in your local .env file.
# AI_PROVIDER=nvidia-nim
# AI_API_KEY=your-nvidia-nim-api-key
# AI_MODEL=meta/llama-3.1-8b-instruct
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_DIMENSIONS=1024

# Ollama example.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
OLLAMA_BASE_URL=http://localhost:11434

# Advanced embedding overrides. Usually leave these blank and use AI_PROVIDER above.
# RAG_EMBEDDING_PROVIDER=hash
# RAG_EMBEDDING_MODEL=hash-embedding-384
# RAG_EMBEDDING_DIMENSIONS=384
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional reranker. Default is local hybrid scoring.
RAG_RERANKER=hybrid
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5

# Advanced chat overrides. Usually leave these blank and use AI_PROVIDER above.
# RAG_CHAT_BASE_URL=https://api.openai.com/v1
# RAG_CHAT_API_KEY=
# RAG_CHAT_MODEL=gpt-4.1-mini